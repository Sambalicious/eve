# Copy to .env and fill in. Never commit .env. Placeholders only.

# Postgres used by docker-compose.yml. This superuser is used only by the
# provision-roles step (SEC-001); the api, worker and migrations never use it.
POSTGRES_USER=postgres_bootstrap
POSTGRES_PASSWORD=change-me-bootstrap-password
POSTGRES_DB=job_assistant

# Migration owner role: owns the schema, runs migrations and installs pg-boss.
DB_OWNER_ROLE=ja_owner
DB_OWNER_PASSWORD=change-me-owner-password
MIGRATION_DATABASE_URL=postgres://ja_owner:change-me-owner-password@postgres:5432/job_assistant

# Runtime role for api and worker: row reads and writes only.
DB_RUNTIME_ROLE=ja_runtime
DB_RUNTIME_PASSWORD=change-me-runtime-password
DATABASE_URL=postgres://ja_runtime:change-me-runtime-password@postgres:5432/job_assistant

# Read-only backup role for scripts/backup/backup.sh (docs/ops/backups.md). It is
# the only role that bypasses row-level security, and it can only SELECT.
# provision-roles creates it and migrate grants it. Use a long random password
# (openssl rand -hex 24). With the password empty the role cannot log in.
DB_BACKUP_ROLE=
DB_BACKUP_PASSWORD=

# api only
# Origin the browser uses for the dashboard and /v1 (same origin; ADR 0007).
PUBLIC_ORIGIN=https://localhost:8443
PORT=3000
# Google Cloud OAuth client (Web application). Authorized redirect URI:
#   <PUBLIC_ORIGIN>/v1/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret
# ID token "sub" of the owner's Google account. Read ONCE by the `migrate` step
# (the multi-candidate migration, 0016-multi-candidate, binds the existing data to the Operator), then remove it: the api
# refuses to start while it is set. To change the account later, run on the host:
#   DATABASE_URL=<owner role url> pnpm --filter @eve/api operator:rebind-sub <google-sub>
CANDIDATE_GOOGLE_SUB=replace-with-google-sub

# Stored files (EPIC-0002 A2). docker-compose.yml sets CANDIDATE_STORAGE_DIR=/data/candidates
# for the api and worker; set it here only when running them outside compose (default
# /data/candidates). RESUME_STORAGE_DIR and DOCUMENT_STORAGE_DIR are retired: remove them,
# the api and worker refuse to start while either is set. Deploy steps: docs/ops/deploy.md.
# CANDIDATE_STORAGE_DIR=/data/candidates

# Anthropic API key for Career Profile drafting. Env only: it is never stored,
# logged, or returned by the API. Nothing is sent until the Candidate approves
# Anthropic in the dashboard (Data and privacy).
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# Cheapest current Claude model (platform.claude.com/docs/en/about-claude/models/overview).
ANTHROPIC_MODEL=claude-haiku-5-5
# Tailored resume and cover letter only. Scoring stays on ANTHROPIC_MODEL. Set it
# to the same value as ANTHROPIC_MODEL to use one model for everything.
ANTHROPIC_DOCUMENTS_MODEL=claude-sonnet-5-5
# Form agent for leftover free-text questions. Off (0) by default: a required
# field without an exact Approved Answer blocks as Missing Approved Answer.
# Set to 1 to let it fill free-text fields only; it never answers choice fields.
SUBMISSION_FORM_AGENT_ENABLED=0
# EPIC-0012 rule 2: posting terms in document prompts. Off (0) unless exactly 1.
DOCUMENT_BRIDGES_ENABLED=0
# EPIC-0012 rule 4: quoted company direction in cover letters. Off (0) unless exactly 1.
DOCUMENT_DIRECTION_ENABLED=0
# Public request-access endpoint (EPIC-0003). Secret: at least 32 random bytes,
# for example `openssl rand -base64 32`. Rotating it resets the per-IP windows.
ACCESS_REQUEST_SECRET=replace-with-32-random-bytes-base64-encoded
# Reverse-proxy hops in front of the api: 1 behind Caddy. 0 limits access
# requests by the global cap only, because every visitor shares one address.
TRUST_PROXY=0
ACCESS_REQUEST_LIMIT_IP_HOUR=3
ACCESS_REQUEST_LIMIT_IP_DAY=10
ACCESS_REQUEST_LIMIT_GLOBAL_DAY=50

# Host ports for docker-compose.yml (change if already in use)
API_HOST_PORT=3000
POSTGRES_HOST_PORT=5432

# worker only: email notifications (Gmail SMTP with an app password). Env only:
# never stored, logged, or shown in the dashboard. Create the app password at
# myaccount.google.com/apppasswords (needs 2-Step Verification). Leave any of
# the three empty and no email is sent; notifications wait until they are set.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
NOTIFY_TO=
# Daily summary email at 21:00 WAT. Off (0) until you turn it on.
NOTIFY_DAILY_SUMMARY_ENABLED=0
# Automatic 12-month expiry of detailed Application records (worker, daily at 03:00 WAT).
# It deletes data irreversibly, so it ships off (1) until database backups are confirmed.
# Set 0 (or remove the line) to turn it on. Operator switch only; the dashboard has no setting.
RETENTION_JOB_DISABLED=1

# Backups (docs/ops/backups.md): host script scripts/backup/backup.sh, run by
# host cron at 02:00 WAT and on demand before deploys. Read by the scripts
# only; no container sees these.
# Public key from `age-keygen -o identity.txt`, run on YOUR computer. Put only
# the age1... public key here. Keep the private identity file off this server
# and out of BACKUP_DIR. Backups refuse to run while this is empty or invalid.
BACKUP_AGE_RECIPIENT=
# Folder for the encrypted files and backup.log. Empty means ~/eve-backups.
# Point it at a synced folder for off-box copies (never one holding the key).
BACKUP_DIR=
# Optional. Days to keep, by file name: 1 to 30 (ADR 0004). Default 30.
BACKUP_RETENTION_DAYS=30
# Optional. Defaults match docker-compose.yml; change only if you renamed them.
BACKUP_COMPOSE_PROJECT=eve
BACKUP_DOCUMENT_VOLUME=job-assistant_document-data
BACKUP_RESUME_VOLUME=job-assistant_resume-data
# EPIC-0002 A2 per-Candidate file root; skipped while the volume does not exist.
BACKUP_CANDIDATE_VOLUME=job-assistant_candidate-data
# Optional. Image for pg tools and the read-only volume tar (already pulled for postgres).
BACKUP_HELPER_IMAGE=postgres:17-alpine
