{
  "name": "@eve/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "migrate": "node dist/db/migrate.cli.js",
    "operator:rebind-sub": "node dist/db/operator-rebind.cli.js",
    "storage:migrate": "node dist/db/storage-migrate.cli.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@eve/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "10.1.4",
    "@mastra/core": "1.78.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "docx": "9.8.1",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "mammoth": "1.13.0",
    "nodemailer": "10.1.7",
    "openid-client": "^6.8.8",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "saxes": "6.0.0",
    "unpdf": "1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "jszip": "3.10.2",
    "msw": "^3.0.3",
    "smtp-server": "3.20.2",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
