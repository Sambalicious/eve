    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:public-output": "node scripts/check-public-output.mjs",
    "og:image": "node scripts/og-image/generate.mjs",
    "sweep:toast": "node scripts/toast-geometry-sweep.mjs"
  },
  "dependencies": {
