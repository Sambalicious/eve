  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/app/prerender.tsx --outDir node_modules/.tmp/prerender && node scripts/prerender.mjs && node scripts/check-public-output.mjs",
